# Copy to .env. Read by both docker compose and the app (REPOBOT_* vars).

# --- vLLM container (docker compose) ---
VLLM_TAG=v0.32.0                # confirmed working on RTX 5070 (Blackwell)
LLM_HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
VLLM_GPU_UTIL=0.80              # 12 GB card: ~5.3 weights + ~1.6 overhead + ~2.6 KV; rest for desktop + embedder
VLLM_MAX_LEN=16384
VLLM_EXTRA_ARGS=                # e.g. --kv-cache-dtype fp8   or   --no-enable-prefix-caching
HF_TOKEN=

# --- App ---
REPOBOT_LLM_BASE_URL=http://localhost:8000/v1   # Ollama fallback: http://localhost:11434/v1
REPOBOT_LLM_MODEL=qwen2.5-coder-7b              # Ollama fallback: qwen2.5-coder:7b
REPOBOT_QDRANT_URL=http://localhost:6333
REPOBOT_EMBED_DEVICE=cuda
REPOBOT_RERANK_DEVICE=cuda
